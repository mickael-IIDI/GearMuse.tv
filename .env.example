# ─────────────────────────────────────────────────────────────────────────────
# Copiez ce fichier en .env.local (développement) ou renseignez ces variables
# chez votre hébergeur. Aucune valeur secrète ne doit être versionnée.
# ─────────────────────────────────────────────────────────────────────────────

# Identité
PROJECT_NAME=GearMuse
NEXT_PUBLIC_PROJECT_NAME=GearMuse
NEXT_PUBLIC_PROJECT_TAGLINE=
# URL canonique, sans slash final. Développement : http://localhost:3000. Production : https://gearmuse.tv
# (valeur par défaut d'un build de production si la variable est vide).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Adresse de contact affichée (mentions légales, contact) : à créer avant de la renseigner, ex. contact@gearmuse.tv
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PUBLISHER_NAME=
NEXT_PUBLIC_PUBLICATION_DIRECTOR=
NEXT_PUBLIC_HOSTING_PROVIDER=
# false = robots.txt interdit l'indexation (préproduction)
ALLOW_INDEXING=true

# Base de données
# Vide → PostgreSQL embarqué (PGlite) dans PGLITE_DIR, idéal en local.
# Production : chaîne de connexion PostgreSQL (Neon : utilisez l'URL « pooled », sslmode=require).
DATABASE_URL=
PGLITE_DIR=./.data/pglite
DATABASE_POOL_MAX=5

# YouTube Data API v3 (recommandé) : durées, dates, statistiques, langue, intégrabilité.
# Sans clé, le pipeline utilise oEmbed et les flux RSS publics (métadonnées partielles).
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000

# Analyse par modèle de langage (facultative, à activer aussi dans Administration > Moteur de sélection)
ANTHROPIC_API_KEY=
# Modèle utilisé (peut aussi être réglé dans l'administration)
AI_MODEL=

# Reddit (facultatif) : application OAuth « script » ou « web » — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:gearmuse-catalog:v0.1 (by /u/votre_compte)

# Administration
# Premier compte propriétaire, créé automatiquement à la première connexion si aucun compte n'existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Secrets aléatoires (32+ caractères) : openssl rand -hex 32
SESSION_SECRET=
IP_HASH_SALT=
# Protège /api/cron/* (Vercel Cron envoie « Authorization: Bearer <CRON_SECRET> »)
CRON_SECRET=

# Ingestion
INGEST_USER_AGENT=
